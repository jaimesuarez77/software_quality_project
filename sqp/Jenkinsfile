// ============================================================
//  Jenkinsfile — Software Quality Project
//  RETO: El equipo debe completar las secciones marcadas con TODO
//  Calidad del Software · VIII Semestre
// ============================================================

pipeline {

    agent any

    environment {
        SONAR_PROJECT_KEY  = "software-quality-project"
        SONAR_PROJECT_NAME = "Software Quality Project"
        SONAR_HOST_URL     = "http://mi-sonarqube:9000"
        COVERAGE_THRESHOLD = "85"
        REPORTS_DIR        = "reports"

        APP_NAME = "software-quality-project"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: "5"))
        timeout(time: 15, unit: "MINUTES")
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        stage("1 · Checkout") {
            steps {
                echo "Descargando código desde el fork del equipo..."
                checkout scm
                sh "ls -la"
            }
        }

        stage('2 · Preparar entorno') {
            steps {
                sh '''
                    python3 -m venv venv
                    . venv/bin/activate

                    pip install --upgrade pip
                    pip install --no-cache-dir -r sqp/requirements.txt
                '''
            }
        }
        stage('3 · Pruebas unitarias') {
            steps {
                sh '''
                    . venv/bin/activate
                    cd sqp

                    pytest \
                    --cov=src \
                    --cov-report=xml:co../reports/coverage.xml \
                    --cov-report=html:../reports/htmlcov \
                    --cov-fail-under=85 \
                    --junitxml=../reports/junit.xml \
                    tests/
                '''
            }

            post {
                always {
                    junit 'reports/junit.xml'
                }
            }
        }

        stage('4 · Análisis SonarQube') {
            steps {
                withSonarQubeEnv('SonarQube') { // 'SonarQube' es el nombre del servidor en Jenkins
                    script {
                        // Cambia 'sonar-scanner' por el nombre exacto de tu configuración global
                        def scannerHome = tool 'SonarScanner' 
                        sh "${scannerHome}/bin/sonar-scanner \
                            -Dsonar.projectKey=software_quality_project \
                            -Dsonar.sources=sqp/src \
                            -Dsonar.tests=sqp/tests \
                            -Dsonar.python.coverage.reportPaths=sqp/reports/coverage.xml"
                    }
                }
            }
        }
        stage("5 · Quality Gate") {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage("6 · Resumen") {
            steps {
                sh """
                    echo "Proyecto : ${APP_NAME}"
                    echo "Branch   : \$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo N/A)"
                    echo "Commit   : \$(git rev-parse --short HEAD 2>/dev/null || echo N/A)"
                """
            }
        }
    }

    post {
        always {
            echo "Pipeline finalizado: ${currentBuild.currentResult}"
        }
        success {
            echo "Build exitoso: el pipeline finalizó correctamente."
        }
        failure {
            echo "Build FALLIDO: revisa SonarQube en ${SONAR_HOST_URL}"
        }
    }
}
