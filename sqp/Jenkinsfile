// ============================================================
//  Jenkinsfile — Software Quality Project
//  RETO: El equipo debe completar las secciones marcadas con TODO
//  Calidad del Software · VII Semestre
// ============================================================

pipeline {

    agent any

    environment {
        SONAR_PROJECT_KEY  = "software-quality-project"
        SONAR_PROJECT_NAME = "Software Quality Project"
        SONAR_HOST_URL     = "http://sonarqube:9000"
        COVERAGE_THRESHOLD = "60"
        REPORTS_DIR        = "reports"

        APP_NAME = "software-quality-project"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: "5"))
        timeout(time: 15, unit: "MINUTES")
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        stage("1 · Checkout") {
            steps {
                echo "Descargando código desde el fork del equipo..."
                checkout scm
                sh "ls -la"
            }
        }

        stage("2 · Preparar entorno") {
            steps {
                dir('sqp') {
                    sh """
                        if command -v python3 >/dev/null 2>&1; then
                            python3 -m pip install --no-cache-dir -r requirements.txt
                        elif command -v python >/dev/null 2>&1; then
                            python -m pip install --no-cache-dir -r requirements.txt
                        else
                            echo "ERROR: Python no está instalado en el agente"
                            exit 1
                        fi
                        mkdir -p ../${REPORTS_DIR}
                    """
                }
            }
        }

        stage("3 · Pruebas unitarias") {
            steps {
                dir('sqp') {
                    sh """
                        if command -v python3 >/dev/null 2>&1; then
                            python3 -m pytest --cov=src --cov-report=xml:../${REPORTS_DIR}/coverage.xml --cov-report=html:../${REPORTS_DIR}/htmlcov --cov-fail-under=${COVERAGE_THRESHOLD} --junitxml=../${REPORTS_DIR}/junit.xml
                        elif command -v python >/dev/null 2>&1; then
                            python -m pytest --cov=src --cov-report=xml:../${REPORTS_DIR}/coverage.xml --cov-report=html:../${REPORTS_DIR}/htmlcov --cov-fail-under=${COVERAGE_THRESHOLD} --junitxml=../${REPORTS_DIR}/junit.xml
                        else
                            echo "ERROR: Python no está instalado en el agente"
                            exit 1
                        fi
                    """
                }
            }
            post {
                always {
                    junit "${REPORTS_DIR}/junit.xml"
                }
            }
        }

        stage("4 · Análisis SonarQube") {
            steps {
                dir('sqp') {
                    withSonarQubeEnv("SonarQube") {
                        sh """
                            sonar-scanner \
                                -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                                -Dsonar.projectName=\"${SONAR_PROJECT_NAME}\" \
                                -Dsonar.sources=src \
                                -Dsonar.tests=tests \
                                -Dsonar.python.coverage.reportPaths=../${REPORTS_DIR}/coverage.xml \
                                -Dsonar.python.version=3
                        """
                    }
                }
            }
        }

        stage("5 · Quality Gate") {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage("6 · Resumen") {
            steps {
                sh """
                    echo "Proyecto : ${APP_NAME}"
                    echo "Branch   : \$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo N/A)"
                    echo "Commit   : \$(git rev-parse --short HEAD 2>/dev/null || echo N/A)"
                """
            }
        }
    }

    post {
        always {
            echo "Pipeline finalizado: ${currentBuild.currentResult}"
        }
        success {
            echo "Build exitoso: el pipeline finalizó correctamente."
        }
        failure {
            echo "Build FALLIDO: revisa SonarQube en ${SONAR_HOST_URL}"
        }
    }
}
